    IN_HW[HW: SCH/DATASHEET/REGS/PIN_MAP]
    IN_STD[STANDARDS]
    IN_TOOL[TOOLCHAIN/ENV]
  end

  subgraph Foundation[基础层]
    S01[S01 CLI入口]
    S02[S02 布局/模板]
