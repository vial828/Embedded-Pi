{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firmware Agent Config",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": {"type": "string"}
      },
      "required": ["name"]
    },
    "context": {
      "type": "object",
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 256},
        "constitution_file": {"type": "string"}
      }
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "max_tokens": {"type": "integer"},
        "temperature": {"type": "number"}
      }
    }
  },
  "required": ["project"]
}
